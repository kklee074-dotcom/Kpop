local function addLog(text, color)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 24)
    label.BackgroundTransparency = 1
    label.TextColor3 = color or Color3.fromRGB(0, 255, 128)
    label.TextSize = 13
    label.Font = Enum.Font.Code
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Text = " " .. text
    label.Parent = scrollingFrame
end

addLog("กำลังเริ่มสแกน Workspace และ ReplicatedStorage...", Color3.fromRGB(255, 255, 0))

-- เริ่มสแกนแบบแยกเธรดกันค้าง
task.spawn(function()
    local count = 0
    local function scanInstance(item)
        pcall(function()
            local attributes = item:GetAttributes()
            if attributes and next(attributes) ~= nil then
                for k, v in pairs(attributes) do
                    addLog("["..item.Name..] " .. k .." = ".. tostring(v), Color3.fromRGB(0, 255, 128))
                    count = count + 1
                end
            end
            if item:IsA("StringValue") or item:IsA("IntValue") or item:IsA("NumberValue") then
                addLog("Value ["..item.Name.."] = "..tostring(item.Value), Color3.fromRGB(100, 200, 255))
                count = count + 1
            end
        end)
    end

    -- สแกน Workspace
    for _, desc in ipairs(game:GetService("Workspace"):GetDescendants()) do
        scanInstance(desc)
    end

    -- สแกน ReplicatedStorage
    for _, desc in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
        scanInstance(desc)
    end

    addLog("สแกนเสร็จสิ้น! พบข้อมูลทั้งหมด " .. count .. " รายการ", Color3.fromRGB(255, 100, 255))
end)
