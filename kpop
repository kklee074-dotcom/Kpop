-- ระบบเบื้องหลัง: ออโต้เก็บเงิน
task.spawn(function()
    while true do
        task.wait(1)
        if _G.AutoCollectCash then
            for _, obj in ipairs(workspace:GetDescendants()) do
                if not _G.AutoCollectCash then break end
                local name = string.lower(obj.Name)
                if name:find("cash") or name:find("money") or name:find("collect") then
                    local part = obj:IsA("Model") and obj.PrimaryPart or (obj:IsA("BasePart") and obj)
                    if part then
                        local char = player.Character
                        if char and char:FindFirstChild("HumanoidRootPart") and basePosition then
                            local hrp = char.HumanoidRootPart
                            local oldPos = hrp.CFrame
                            hrp.CFrame = part.CFrame
                            task.wait(0.2)
                            hrp.CFrame = oldPos
                            task.wait(0.5)
                        end
                    end
                end
            end
        end
    end
end)

-- ระบบเบื้องหลัง: ออโต้ฟาร์มการ์ด
task.spawn(function()
    while true do
        task.wait(0.5)
        if _G.AutoFarmCard and basePosition then
            local cardsFolder = workspace:FindFirstChild("Cards") or workspace
            local found = false
            
            for _, item in ipairs(cardsFolder:GetDescendants()) do
                if not _G.AutoFarmCard then break end
                
                if string.find(string.lower(item.Name), string.lower(targetRarity)) then
                    local targetPart = item:IsA("Model") and item.PrimaryPart or (item:IsA("BasePart") and item)
                    
                    if targetPart then
                        local currentCharacter = player.Character
                        if currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart") then
                            local hrp = currentCharacter.HumanoidRootPart
                            
                            hrp.CFrame = targetPart.CFrame
                            task.wait(math.random(30, 60) / 100) 
                            hrp.CFrame = basePosition
                            found = true
                            task.wait(math.random(50, 100) / 100)
                            break
                        end
                    end
                end
            end
        end
    end
end)
