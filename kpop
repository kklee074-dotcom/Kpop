-- สร้างปุ่มเลือกหมวดหมู่ (Tabs)
local tabButtons = {}
local tabContents = {}

local function createTab(name, order)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.33, 0, 1, 0)
    btn.Position = UDim2.new((order - 1) * 0.33, 0, 0, 0)
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 13
    btn.Font = Enum.Font.SourceSansBold
    btn.Parent = TabBar
    tabButtons[name] = btn

    local content = Instance.new("ScrollingFrame")
    content.Size = UDim2.new(1, -10, 1, -85)
    content.Position = UDim2.new(0, 5, 0, 75)
    content.BackgroundTransparency = 1
    content.Visible = false
    content.CanvasSize = UDim2.new(0, 0, 0, 300)
    content.ScrollBarThickness = 4
    content.Parent = MainFrame
    tabContents[name] = content

    btn.MouseButton1Click:Connect(function()
        for k, c in pairs(tabContents) do
            c.Visible = (k == name)
            tabButtons[k].BackgroundColor3 = (k == name) and Color3.fromRGB(80, 80, 80) or Color3.fromRGB(50, 50, 50)
        end
    end)
    
    return content
end

