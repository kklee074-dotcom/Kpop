-- ฟังก์ชันเซ็ตฐานอัตโนมัติเมื่อตัวละครเกิดใหม่
local function onCharacterAdded(char)
    local rootPart = char:WaitForChild("HumanoidRootPart", 10)
    local humanoid = char:WaitForChild("Humanoid", 10)
    
    if rootPart then
        task.wait(0.5)
        basePosition = rootPart.CFrame
    end
    
    if humanoid then
        humanoid.Changed:Connect(function(property)
            if property == "WalkSpeed" and _G.SpeedEnabled and humanoid.WalkSpeed ~= _G.CustomSpeed then
                humanoid.WalkSpeed = _G.CustomSpeed
            end
        end)
    end
end

if player.Character then
    onCharacterAdded(player.Character)
end
player.CharacterAdded:Connect(onCharacterAdded)

-- ระบบ Noclip และ Speed Hack
RunService.Stepped:Connect(function()
    if _G.NoclipEnabled and player.Character then
        for _, part in ipairs(player.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
    
    if _G.SpeedEnabled and player.Character then
        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.WalkSpeed ~= _G.CustomSpeed then
            humanoid.WalkSpeed = _G.CustomSpeed
        end
    end
end)

-- ระบบ ESP (มองเห็นการ์ดทะลุกำแพง)
task.spawn(function()
    while true do
        task.wait(1)
        if _G.ESPEnabled then
            local cardsFolder = workspace:FindFirstChild("Cards") or workspace
            for _, item in ipairs(cardsFolder:GetDescendants()) do
                if (item:IsA("BasePart") or item:IsA("Model")) then
                    local targetPart = item:IsA("Model") and item.PrimaryPart or item
                    if targetPart and not item:FindFirstChild("CardESPBox") then
                        local billboard = Instance.new("BillboardGui")
                        billboard.Name = "CardESPBox"
                        billboard.Size = UDim2.new(0, 100, 0, 40)
                        billboard.AlwaysOnTop = true
                        billboard.StudsOffset = Vector3.new(0, 2, 0)
                        
                        local textLabel = Instance.new("TextLabel")
                        textLabel.Size = UDim2.new(1, 0, 1, 0)
                        textLabel.BackgroundTransparency = 1
                        textLabel.Text = item.Name
                        textLabel.TextColor3 = Color3.fromRGB(0, 255, 255)
                        textLabel.TextSize = 12
                        textLabel.Font = Enum.Font.SourceSansBold
                        textLabel.Parent = billboard
                        
                        billboard.Parent = targetPart
                    end
                end
            end
        else
            local cardsFolder = workspace:FindFirstChild("Cards") or workspace
            for _, item in ipairs(cardsFolder:GetDescendants()) do
                if item:FindFirstChild("CardESPBox") then
                    item.CardESPBox:Destroy()
                end
            end
        end
    end
end)

